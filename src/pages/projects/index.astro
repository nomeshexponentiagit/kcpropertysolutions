---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import PropertyCard from '../../components/properties/PropertyCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../lib/properties';

const allProperties = await getCollection('properties');
const categoryEntries = Object.entries(CATEGORIES);
---

<BaseLayout
  title="Properties | KC Property Solutions"
  description="Browse our portfolio of premium plots, villas, guest houses, apartments, hotels, and resorts across North & South Goa."
>
  <section class="section-padding bg-sand-50">
    <div class="container-wide">
      <SectionHeading
        eyebrow="Our Portfolio"
        title="Properties in Goa"
        accent="brass"
      />

      <!-- Category filter tabs -->
      <div class="flex flex-wrap gap-2 mt-8 pb-2 overflow-x-auto" id="category-tabs">
        {categoryEntries.map(([key, cat]) => (
          <button
            type="button"
            data-category={cat.slug || 'all'}
            class={`filter-tab whitespace-nowrap text-xs font-semibold tracking-wider uppercase px-4 py-2.5 rounded-sm border transition-all duration-200 ${
              key === 'all'
                ? 'bg-palm-900 text-white border-palm-900'
                : 'bg-white text-ink-light border-sand-200 hover:border-palm-600 hover:text-palm-900'
            }`}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Property grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8" id="property-grid">
        {allProperties.map((property) => (
          <div class="property-item" data-category={property.data.category}>
            <PropertyCard property={property} />
          </div>
        ))}
      </div>

      <!-- Empty state -->
      <div id="no-results" class="hidden text-center py-16">
        <p class="text-ink-light/50 text-sm">No properties found in this category yet.</p>
        <button
          type="button"
          id="show-all-btn"
          class="text-palm-700 font-semibold text-sm mt-2 inline-block hover:underline cursor-pointer"
        >
          View all properties →
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initFilters() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
    const items = document.querySelectorAll<HTMLElement>('.property-item');
    const noResults = document.getElementById('no-results');
    const showAllBtn = document.getElementById('show-all-btn');

    function applyFilter(category: string) {
      let visible = 0;

      items.forEach((item) => {
        const itemCat = item.dataset.category;
        if (category === 'all' || itemCat === category) {
          item.style.display = '';
          visible++;
        } else {
          item.style.display = 'none';
        }
      });

      // Show/hide empty state
      if (noResults) {
        noResults.classList.toggle('hidden', visible > 0);
      }
    }

    function updateTabs(category: string) {
      tabs.forEach((tab) => {
        const tabCat = tab.dataset.category;
        if (tabCat === category) {
          tab.classList.add('bg-palm-900', 'text-white', 'border-palm-900');
          tab.classList.remove('bg-white', 'text-ink-light', 'border-sand-200', 'hover:border-palm-600', 'hover:text-palm-900');
        } else {
          tab.classList.remove('bg-palm-900', 'text-white', 'border-palm-900');
          tab.classList.add('bg-white', 'text-ink-light', 'border-sand-200', 'hover:border-palm-600', 'hover:text-palm-900');
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const category = tab.dataset.category || 'all';
        applyFilter(category);
        updateTabs(category);
        // Update URL without reload
        const url = category === 'all' ? '/projects' : `/projects?category=${category}`;
        history.replaceState({}, '', url);
      });
    });

    if (showAllBtn) {
      showAllBtn.addEventListener('click', () => {
        applyFilter('all');
        updateTabs('all');
        history.replaceState({}, '', '/projects');
      });
    }

    // Apply filter from URL on page load
    const params = new URLSearchParams(window.location.search);
    const initialCategory = params.get('category') || 'all';
    applyFilter(initialCategory);
    updateTabs(initialCategory);
  }

  initFilters();
</script>
