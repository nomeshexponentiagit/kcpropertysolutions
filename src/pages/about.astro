---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { site } from '../lib/site';
---

<BaseLayout
  title="About Us | KC Property Solution Goa"
  description="KC Property Solution Goa — Goa's premium luxury real estate consultant. Curating bespoke residences, boutique hospitality assets, and commercial spaces across North & South Goa."
>
  <!-- Hero -->
  <section class="relative bg-palm-950 py-20 md:py-28">
    <div class="container-wide text-center relative z-10">
      <span class="text-xs font-sans font-semibold tracking-[0.2em] uppercase text-brass-400/80">About Us</span>
      <h1 class="font-serif text-3xl md:text-5xl font-bold text-white mt-3 leading-tight">
        Where Vision Meets Value
      </h1>
      <p class="text-sand-200/60 text-sm md:text-base mt-3 max-w-lg mx-auto">
        A luxury real estate consultant curating premium properties across Goa's most prestigious addresses
      </p>
    </div>
    <div class="absolute inset-0 opacity-20 bg-gradient-to-br from-palm-900 via-palm-800 to-palm-950" />
  </section>

  <!-- Our Story -->
  <section class="section-padding bg-sand-50">
    <div class="container-wide max-w-4xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <SectionHeading eyebrow="Our Story" title="A Luxury Real Estate Consultant" accent="brass" />
          <div class="mt-6 space-y-4 text-sm md:text-base text-ink-light/80 leading-relaxed">
            <p>
              KC Property Solution is more than real estate — it's an integrated lifestyle ecosystem that combines brand prestige, experiential excellence, and financial performance. From an investment perspective, we deliver properties that double as wealth-building assets.
            </p>
            <p>
              Every asset in our portfolio is carefully positioned to optimise profitability while creating lasting value for both clients and investors. Our phased, location-driven development strategy with cross-promotional synergies maximises ROI and ensures brand consistency.
            </p>
            <p>
              We don't just sell properties — we curate wealth-building assets and lifestyle legacies. With a proven track record in strategic acquisitions, development, and operational excellence, we guide every buyer from first viewing to final signature.
            </p>
          </div>
        </div>
        <div class="aspect-[3/4] bg-sand-100 rounded-sm border border-sand-200 flex items-center justify-center">
          <div class="text-center p-8">
            <div class="w-20 h-20 mx-auto rounded-full bg-palm-900/10 flex items-center justify-center">
              <svg width="36" height="36" viewBox="0 0 48 48" fill="none" class="text-palm-900">
                <path d="M8 38V16a16 16 0 0 1 32 0v22" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                <path d="M8 38h32" stroke="currentColor" stroke-width="2.5"/>
              </svg>
            </div>
            <p class="font-serif text-2xl font-bold text-palm-900 mt-4">KC</p>
            <p class="text-xs tracking-[0.3em] uppercase text-ink-light/40 mt-1">Property Solution Goa</p>
            <p class="text-sm text-ink-light/50 mt-4">Est. 2014</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Specialization -->
  <section class="section-padding bg-sand-100">
    <div class="container-wide max-w-4xl">
      <SectionHeading eyebrow="What We Do" title="We Specialise In" accent="laterite" />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10">
        <div class="bg-white border border-sand-200 rounded-sm p-6">
          <h3 class="font-serif text-lg font-bold text-palm-900">Luxury Villas</h3>
          <p class="text-sm text-ink-light/60 mt-2 leading-relaxed">
            Bespoke residences for discerning clients — beachfront estates, sea-view designer villas, gated luxury communities, managed rental villas, and holiday homes with appreciation potential.
          </p>
        </div>
        <div class="bg-white border border-sand-200 rounded-sm p-6">
          <h3 class="font-serif text-lg font-bold text-palm-900">Hotels & Resorts</h3>
          <p class="text-sm text-ink-light/60 mt-2 leading-relaxed">
            Boutique hospitality assets in Goa's most coveted tourist corridors — operational boutique resorts, hospitality redevelopment projects, high-demand tourist zone assets, and investment-ready hospitality properties.
          </p>
        </div>
        <div class="bg-white border border-sand-200 rounded-sm p-6">
          <h3 class="font-serif text-lg font-bold text-palm-900">Plots & Lands</h3>
          <p class="text-sm text-ink-light/60 mt-2 leading-relaxed">
            Premium plots in Goa's high-street prime locations — carefully selected for location, zoning compliance, and investment value. Ideal for villa construction or long-term capital appreciation.
          </p>
        </div>
        <div class="bg-white border border-sand-200 rounded-sm p-6">
          <h3 class="font-serif text-lg font-bold text-palm-900">Commercial Spaces</h3>
          <p class="text-sm text-ink-light/60 mt-2 leading-relaxed">
            Grade-A commercial assets delivering strong rental yields — high-footfall lifestyle venues, retail spaces, and office properties with proven revenue models across Goa's urban investment corridors.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Process -->
  <section class="section-padding bg-sand-50">
    <div class="container-wide max-w-4xl">
      <SectionHeading eyebrow="Our Expertise" title="Your Acquisition. Our Expertise." accent="brass" />
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mt-10">
        {[
          { num: "1", title: "Curated Luxury Listings", desc: "Handpicked properties matching your investment goals" },
          { num: "2", title: "Private Site Visits", desc: "Personalised property tours with expert guidance" },
          { num: "3", title: "End-to-End Documentation", desc: "Complete legal and paperwork support" },
          { num: "4", title: "Off-Market Opportunities", desc: "Exclusive access to unlisted premium assets" },
          { num: "5", title: "Negotiation Expertise", desc: "Skilled representation for optimal deal terms" },
          { num: "6", title: "Due Diligence", desc: "Thorough market and legal risk evaluation" },
        ].map((item) => (
          <div class="bg-white border border-sand-200 rounded-sm p-5 text-center">
            <span class="text-2xl font-serif font-bold text-brass-500">{item.num}</span>
            <h3 class="font-serif text-sm font-bold text-palm-900 mt-2">{item.title}</h3>
            <p class="text-xs text-ink-light/60 mt-1 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section-padding bg-sand-100">
    <div class="container-wide max-w-4xl">
      <SectionHeading eyebrow="Why KC" title="Quality Over Quantity. Relationships Over Transactions." accent="laterite" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-10">
        {[
          { title: "Deep Local Expertise", desc: "Mastery of Goa's luxury micro-markets and prime corridors" },
          { title: "Exclusive Access", desc: "Off-market and pre-launch opportunities for our clients" },
          { title: "Discreet Transactions", desc: "Confidential, white-glove service for every engagement" },
          { title: "Strong Network", desc: "Established legal, developer, and government relationships" },
        ].map((item) => (
          <div class="bg-white border border-sand-200 rounded-sm p-6 text-center">
            <h3 class="font-serif text-base font-bold text-palm-900">{item.title}</h3>
            <p class="text-sm text-ink-light/60 mt-2 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Registration -->
  <section class="section-padding bg-sand-50">
    <div class="container-wide max-w-4xl text-center">
      <SectionHeading eyebrow="Credentials" title="RERA Registered" accent="brass" />
      <p class="mt-4 text-sm text-ink-light/70">
        KC Property Solution Goa is a registered real estate agent under the Goa Real Estate Regulatory Authority.
      </p>
      <p class="mt-2 font-mono text-lg font-bold text-palm-900">RERA: AGGO10252013</p>
    </div>
  </section>
</BaseLayout>
