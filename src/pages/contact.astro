---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { site } from '../lib/site';
import { whatsappLink, telLink } from '../lib/format';
---

<BaseLayout
  title="Contact Us | KC Property Solutions"
  description="Get in touch with KC Property Solutions. We're here to help you find your dream property in Goa."
>
  <!-- Hero -->
  <section class="relative bg-palm-950 py-20 md:py-28">
    <div class="container-wide text-center relative z-10">
      <span class="text-xs font-sans font-semibold tracking-[0.2em] uppercase text-brass-400/80">Get In Touch</span>
      <h1 class="font-serif text-3xl md:text-5xl font-bold text-white mt-3 leading-tight">
        Contact Us
      </h1>
      <p class="text-sand-200/60 text-sm md:text-base mt-3 max-w-md mx-auto">
        We'd love to hear from you. Reach out via phone, WhatsApp, email, or the form below.
      </p>
    </div>
    <div class="absolute inset-0 opacity-20 bg-gradient-to-br from-palm-900 via-palm-800 to-palm-950" />
  </section>

  <section class="section-padding bg-sand-50">
    <div class="container-wide">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact form -->
        <div>
          <SectionHeading eyebrow="Send a Message" title="Enquire Now" accent="brass" />
          <div class="mt-8">
            <ContactForm />
          </div>
        </div>

        <!-- Contact info -->
        <div>
          <SectionHeading eyebrow="Reach Us" title="Contact Information" accent="laterite" />
          <div class="mt-8 space-y-6">
            <!-- Address -->
            {site.addresses.map((addr) => (
              <div class="bg-white border border-sand-200 rounded-sm p-6">
                <h3 class="font-serif text-base font-bold text-palm-900">{addr.name}</h3>
                <p class="text-sm text-ink-light/70 mt-2 leading-relaxed">{addr.address}</p>
                <div class="flex flex-wrap gap-4 mt-3">
                  <a href={telLink(addr.phone)} class="text-sm font-semibold text-palm-700 hover:text-palm-600 transition-colors">
                    📞 {addr.phone}
                  </a>
                </div>
              </div>
            ))}

            <!-- Quick contact cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <a
                href={telLink(site.phone)}
                class="bg-white border border-sand-200 rounded-sm p-5 text-center hover:shadow-md transition-all duration-300 group"
              >
                <span class="text-2xl" aria-hidden="true">📞</span>
                <p class="text-sm font-semibold text-palm-900 mt-2 group-hover:text-palm-700">Call Us</p>
                <p class="text-xs text-ink-light/50 mt-1">{site.phone}</p>
              </a>
              <a
                href={whatsappLink(site.whatsapp, 'Hi KC Property Solutions!')}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-white border border-sand-200 rounded-sm p-5 text-center hover:shadow-md transition-all duration-300 group"
              >
                <span class="text-2xl" aria-hidden="true">💬</span>
                <p class="text-sm font-semibold text-palm-900 mt-2 group-hover:text-palm-700">WhatsApp</p>
                <p class="text-xs text-ink-light/50 mt-1">Chat Instantly</p>
              </a>
              <a
                href={`mailto:${site.email}`}
                class="bg-white border border-sand-200 rounded-sm p-5 text-center hover:shadow-md transition-all duration-300 group sm:col-span-2"
              >
                <span class="text-2xl" aria-hidden="true">✉️</span>
                <p class="text-sm font-semibold text-palm-900 mt-2 group-hover:text-palm-700">Email</p>
                <p class="text-xs text-ink-light/50 mt-1">{site.email}</p>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
