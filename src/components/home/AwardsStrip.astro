---
import SectionHeading from '../ui/SectionHeading.astro';
import { site } from '../../lib/site';
---

{site.awards.length > 0 && (
  <section class="section-padding bg-sand-50">
    <div class="container-wide">
      <SectionHeading
        eyebrow="Recognition"
        title="Awards & Accolades"
        accent="brass"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10">
        {site.awards.map((award) => (
          <div class="group bg-white border border-sand-200 rounded-sm p-6 md:p-8 flex gap-5 items-start hover:shadow-md transition-all duration-300">
            <!-- Award icon -->
            <div class="flex-shrink-0 w-14 h-14 rounded-full bg-brass-500/10 flex items-center justify-center">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-brass-500">
                <path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6.4-4.6-6.4 4.6 2.4-7.2-6-4.8h7.6z" fill="currentColor"/>
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-lg font-bold text-palm-900">{award.title}</h3>
              <p class="text-sm text-ink-light/60 mt-1">{award.org}</p>
              <span class="text-xs text-brass-500 font-semibold mt-2 inline-block tracking-wider">{award.year}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
