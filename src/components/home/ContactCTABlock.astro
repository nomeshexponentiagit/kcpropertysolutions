---
import { site } from '../../lib/site';
import { whatsappLink } from '../../lib/format';
---

<section class="py-16 md:py-24 bg-palm-900 relative overflow-hidden">
  <!-- Decorative bg -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 right-0 w-96 h-96 rounded-full bg-brass-500/30 blur-3xl" />
    <div class="absolute bottom-0 left-0 w-64 h-64 rounded-full bg-ocean-500/30 blur-3xl" />
  </div>

  <div class="container-wide relative z-10 text-center">
    <span class="text-xs font-sans font-semibold tracking-[0.2em] uppercase text-brass-400/80">Get In Touch</span>
    <h2 class="font-serif text-2xl md:text-4xl font-bold text-white mt-3 leading-tight">
      Ready to Find Your Dream Property?
    </h2>
    <p class="text-sand-200/60 text-sm md:text-base mt-4 max-w-lg mx-auto leading-relaxed">
      Our team of Goa real estate experts is here to guide you through every step.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
      <a
        href="/contact"
        class="inline-flex items-center gap-2 bg-brass-500 text-white px-8 py-4 rounded-sm font-sans text-sm font-semibold tracking-wide hover:bg-brass-400 transition-all duration-300"
      >
        Contact Us
        <span aria-hidden="true">→</span>
      </a>
      <a
        href={whatsappLink(site.whatsapp, 'Hi KC Property Solutions, I would like to enquire about a property.')}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 border border-brass-500/40 text-brass-400 px-8 py-4 rounded-sm font-sans text-sm font-semibold tracking-wide hover:bg-brass-500/10 transition-all duration-300"
      >
        Chat on WhatsApp
      </a>
    </div>

    <p class="text-sand-300/40 text-xs mt-6">
      Or call us at <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="text-brass-400 hover:text-brass-300">{site.phone}</a>
    </p>
  </div>
</section>
