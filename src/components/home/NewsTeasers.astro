---
import SectionHeading from '../ui/SectionHeading.astro';
import NewsCard from '../news/NewsCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const featuredPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

{featuredPosts.length > 0 && (
  <section class="section-padding bg-sand-50">
    <div class="container-wide">
      <div class="flex items-end justify-between">
        <SectionHeading
          eyebrow="Insights"
          title="News & Articles"
          accent="laterite"
        />
        <a
          href="/news"
          class="hidden md:inline-flex items-center gap-1 text-sm font-semibold text-palm-900 hover:text-palm-600 transition-colors group"
        >
          View All
          <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
        {featuredPosts.map((post) => (
          <NewsCard post={post} />
        ))}
      </div>

      <div class="text-center mt-8 md:hidden">
        <a
          href="/news"
          class="inline-flex items-center gap-1 text-sm font-semibold text-palm-900 hover:text-palm-600 transition-colors group"
        >
          View All Articles
          <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
)}
