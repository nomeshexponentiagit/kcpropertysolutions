---
export interface Props {
  variant?: 'light' | 'dark';
  className?: string;
}

const { variant = 'dark', className = '' } = Astro.props;
const textColor = variant === 'light' ? 'text-white' : 'text-palm-900';
const accentColor = variant === 'light' ? 'text-brass-400' : 'text-brass-500';
---

<a href="/" class={`inline-flex items-center gap-3 ${className}`} aria-label="KC Property Solutions — Home">
  <!-- Arch + Palm Mark -->
  <svg
    width="42"
    height="42"
    viewBox="0 0 48 48"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- Outer arch / oculus -->
    <path
      d="M8 38V16a16 16 0 0 1 32 0v22"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      class={accentColor}
    />
    <!-- KC letters -->
    <text x="24" y="28" text-anchor="middle"
      font-family="Georgia, serif" font-weight="bold" font-size="16"
      fill="currentColor" class={textColor}>KC</text>
    <!-- Palm frond vein -->
    <path
      d="M24 14c-2 4-4 8-2 12 1-3 3-5 6-6"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      class={textColor}
    />
  </svg>

  <!-- Wordmark -->
  <div class="flex flex-col leading-tight">
    <span class={`font-serif text-lg font-bold tracking-tight ${textColor}`}>
      KC <span class="tracking-[0.2em] text-xs font-sans font-normal opacity-70">PROPERTY SOLUTIONS</span>
    </span>
  </div>
</a>
