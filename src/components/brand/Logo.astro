---
export interface Props {
  variant?: 'light' | 'dark';
  className?: string;
}

const { variant = 'dark', className = '' } = Astro.props;
const primary = variant === 'light' ? '#FFFFFF' : '#0B3D2E';
const accent = variant === 'light' ? '#DAB940' : '#C9A227';
const muted = variant === 'light' ? '#D4C6A8' : '#3A3D3C';
---

<a href="/" class={`inline-flex items-center gap-3 group ${className}`} aria-label="KC Property Solution Goa — Home">
  <!-- Icon Mark: Building + K -->
  <svg
    width="44"
    height="44"
    viewBox="0 0 48 48"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="flex-shrink-0"
  >
    <!-- Building body -->
    <rect x="10" y="18" width="12" height="22" rx="1.5" fill={primary} />
    <!-- Roof -->
    <path d="M7 18L16 8L25 18Z" fill={accent} />
    <!-- Door -->
    <rect x="13" y="30" width="6" height="10" rx="1" fill={variant === 'light' ? '#06281E' : '#F7F4EE'} />
    <!-- Window -->
    <rect x="14" y="21" width="4" height="4" rx="0.5" fill={variant === 'light' ? '#06281E' : '#F7F4EE'} opacity="0.6" />
  </svg>

  <!-- Wordmark -->
  <div class="flex flex-col leading-tight">
    <span class="flex items-baseline gap-1">
      <span class={`font-serif text-xl font-extrabold tracking-tight`} style={`color:${primary}`}>KC</span>
      <span class={`text-[10px] font-sans font-semibold tracking-[0.25em] uppercase`} style={`color:${muted}`}>Property Solution</span>
    </span>
    <span class={`text-[9px] font-sans font-medium tracking-[0.15em] uppercase -mt-0.5`} style={`color:${accent}`}>elevate your living</span>
  </div>
</a>
