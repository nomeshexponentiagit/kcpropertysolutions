---
import Logo from '../brand/Logo.astro';
import { site } from '../../lib/site';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Projects', href: '/projects' },
  { label: 'News', href: '/news' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="fixed top-0 left-0 right-0 z-40 bg-sand-50/95 backdrop-blur-md border-b border-sand-200/50">
  <div class="container-wide flex items-center justify-between h-16 md:h-20">
    <Logo />

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-ink-light/70 hover:text-palm-900 transition-colors duration-200 tracking-wide"
        >
          {link.label}
        </a>
      ))}
      <a
        href={`tel:${site.phone.replace(/\s/g, '')}`}
        class="text-sm font-semibold text-brass-500 hover:text-brass-400 transition-colors"
      >
        {site.phone}
      </a>
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="block w-6 h-0.5 bg-palm-900 rounded transition-transform" />
      <span class="block w-6 h-0.5 bg-palm-900 rounded transition-opacity" />
      <span class="block w-4 h-0.5 bg-palm-900 rounded transition-transform" />
    </button>
  </div>

  <!-- Mobile nav panel -->
  <div
    id="mobile-nav"
    class="hidden md:hidden bg-sand-50 border-t border-sand-200"
  >
    <nav class="container-wide flex flex-col py-4 gap-1" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-base font-medium text-ink-light py-3 px-2 hover:text-palm-900 hover:bg-sand-100 rounded-sm transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href={`tel:${site.phone.replace(/\s/g, '')}`}
        class="text-base font-semibold text-brass-500 py-3 px-2 mt-2"
      >
        📞 {site.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const nav = document.getElementById('mobile-nav');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(open));
      const [top, mid, bot] = btn.querySelectorAll('span');
      if (!open) {
        top.style.transform = 'rotate(45deg) translate(4px, 4px)';
        mid.style.opacity = '0';
        bot.style.transform = 'rotate(-45deg) translate(4px, -4px)';
        bot.style.width = '1.5rem';
      } else {
        top.style.transform = '';
        mid.style.opacity = '';
        bot.style.transform = '';
        bot.style.width = '1rem';
      }
    });
  }
</script>
