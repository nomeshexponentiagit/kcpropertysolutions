---
export interface Props {
  propertyTitle?: string;
  propertySlug?: string;
}

const { propertyTitle, propertySlug } = Astro.props;
const web3formsKey = 'YOUR_WEB3FORMS_ACCESS_KEY'; // Replace with your actual key
---

<div class="bg-sand-100 border border-sand-200 rounded-sm p-6 md:p-8">
  <h3 class="font-serif text-xl font-bold text-palm-900">Enquire About This Property</h3>
  <p class="text-sm text-ink-light/60 mt-1 mb-6">Fill in your details and our team will get back to you shortly.</p>

  <form
    action="https://api.web3forms.com/submit"
    method="POST"
    class="space-y-4"
  >
    <input type="hidden" name="access_key" value={web3formsKey} />
    <input type="hidden" name="subject" value={`Enquiry: ${propertyTitle || 'Property'} - KC Property Solutions`} />
    {propertyTitle && <input type="hidden" name="property" value={propertyTitle} />}
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

    <div>
      <label for="enq-name" class="block text-xs font-sans font-semibold tracking-wide text-ink-light mb-1.5">Full Name *</label>
      <input type="text" id="enq-name" name="name" required
        class="w-full px-4 py-3 bg-white border border-sand-200 rounded-sm text-sm text-ink placeholder:text-ink-light/40 focus:outline-none focus:border-palm-600 transition-colors"
        placeholder="Your name" />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="enq-email" class="block text-xs font-sans font-semibold tracking-wide text-ink-light mb-1.5">Email *</label>
        <input type="email" id="enq-email" name="email" required
          class="w-full px-4 py-3 bg-white border border-sand-200 rounded-sm text-sm text-ink placeholder:text-ink-light/40 focus:outline-none focus:border-palm-600 transition-colors"
          placeholder="you@example.com" />
      </div>
      <div>
        <label for="enq-phone" class="block text-xs font-sans font-semibold tracking-wide text-ink-light mb-1.5">Phone *</label>
        <input type="tel" id="enq-phone" name="phone" required
          class="w-full px-4 py-3 bg-white border border-sand-200 rounded-sm text-sm text-ink placeholder:text-ink-light/40 focus:outline-none focus:border-palm-600 transition-colors"
          placeholder="+91 98XXX XXXXX" />
      </div>
    </div>

    <div>
      <label for="enq-message" class="block text-xs font-sans font-semibold tracking-wide text-ink-light mb-1.5">Message</label>
      <textarea id="enq-message" name="message" rows="3"
        class="w-full px-4 py-3 bg-white border border-sand-200 rounded-sm text-sm text-ink placeholder:text-ink-light/40 focus:outline-none focus:border-palm-600 transition-colors resize-none"
        placeholder="I would like to know more about this property..."></textarea>
    </div>

    <button type="submit"
      class="w-full inline-flex items-center justify-center gap-2 bg-brass-500 text-white px-8 py-4 rounded-sm font-sans text-sm font-semibold tracking-wide hover:bg-brass-400 transition-all duration-300">
      Send Enquiry
      <span aria-hidden="true">→</span>
    </button>

    <p class="text-[11px] text-ink-light/40 text-center mt-3">We respect your privacy. Your details are safe with us.</p>
  </form>
</div>
