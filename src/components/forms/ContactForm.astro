---
export interface Props {
  hiddenFields?: Record<string, string>;
}

const { hiddenFields = {} } = Astro.props;
---

<div id="contact-form-wrapper">
  <!-- Form -->
  <form id="contact-form" class="space-y-5">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="name" class="block text-xs font-sans font-semibold tracking-wide text-ink-light mb-1.5">Full Name *</label>
        <input
          type="text" id="name" name="name" required
          class="w-full px-4 py-3 bg-white border border-sand-200 rounded-sm text-sm text-ink placeholder:text-ink-light/40 focus:outline-none focus:border-palm-600 transition-colors"
          placeholder="Your name"
        />
      </div>
      <div>
        <label for="email" class="block text-xs font-sans font-semibold tracking-wide text-ink-light mb-1.5">Email Address *</label>
        <input
          type="email" id="email" name="email" required
          class="w-full px-4 py-3 bg-white border border-sand-200 rounded-sm text-sm text-ink placeholder:text-ink-light/40 focus:outline-none focus:border-palm-600 transition-colors"
          placeholder="you@example.com"
        />
      </div>
    </div>

    <div>
      <label for="phone" class="block text-xs font-sans font-semibold tracking-wide text-ink-light mb-1.5">Phone Number *</label>
      <input
        type="tel" id="phone" name="phone" required
        class="w-full px-4 py-3 bg-white border border-sand-200 rounded-sm text-sm text-ink placeholder:text-ink-light/40 focus:outline-none focus:border-palm-600 transition-colors"
        placeholder="+91 98XXX XXXXX"
      />
    </div>

    <div>
      <label for="message" class="block text-xs font-sans font-semibold tracking-wide text-ink-light mb-1.5">Message *</label>
      <textarea
        id="message" name="message" rows="4" required
        class="w-full px-4 py-3 bg-white border border-sand-200 rounded-sm text-sm text-ink placeholder:text-ink-light/40 focus:outline-none focus:border-palm-600 transition-colors resize-none"
        placeholder="I'm interested in..."
      ></textarea>
    </div>

    <button
      type="submit"
      class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#25D366] text-white px-8 py-4 rounded-sm font-sans text-sm font-semibold tracking-wide hover:bg-[#20bd5a] transition-all duration-300"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/></svg>
      Start WhatsApp Chat
    </button>
  </form>

  <!-- Thank You Message -->
  <div id="contact-thankyou" class="hidden text-center py-10">
    <div class="w-14 h-14 mx-auto rounded-full bg-[#25D366]/10 flex items-center justify-center">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <h4 class="font-serif text-lg font-bold text-palm-900 mt-4">Thank You!</h4>
    <p class="text-sm text-ink-light/60 mt-2 leading-relaxed">Your enquiry has been sent via WhatsApp.<br/>Our team will respond shortly.</p>
  </div>
</div>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', function(e) {
    e.preventDefault();

    const name = (document.getElementById('name') as HTMLInputElement)?.value.trim() || '';
    const email = (document.getElementById('email') as HTMLInputElement)?.value.trim() || '';
    const phone = (document.getElementById('phone') as HTMLInputElement)?.value.trim() || '';
    const message = (document.getElementById('message') as HTMLTextAreaElement)?.value.trim() || '';

    if (!name || !email || !phone || !message) return;

    const waMessage = [
      '*New Enquiry from Website* 📩',
      '',
      '*Full Name:* ' + name,
      '*Email:* ' + email,
      '*Phone:* ' + phone,
      '*Message:* ' + message,
      '',
      '_Sent via KC Property Solution Goa_',
    ];

    const waUrl = 'https://wa.me/919011436002?text=' + encodeURIComponent(waMessage.join('\n'));

    // Show thank you
    document.getElementById('contact-form')?.classList.add('hidden');
    document.getElementById('contact-thankyou')?.classList.remove('hidden');

    // Open WhatsApp
    window.open(waUrl, '_blank');
  });
</script>
