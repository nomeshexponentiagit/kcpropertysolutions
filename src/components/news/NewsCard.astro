---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../../lib/format';

const { post } = Astro.props as { post: CollectionEntry<'posts'> };
---

<a
  href={`/news/${post.id}`}
  class="group block bg-white border border-sand-200 rounded-sm overflow-hidden hover:shadow-md hover:-translate-y-1 transition-all duration-300"
>
  <div class="aspect-[16/9] bg-sand-100 relative overflow-hidden">
    <img
      src={post.data.coverImage}
      alt={post.data.title}
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
    />
    <div class="absolute top-3 left-3 flex flex-wrap gap-1">
      {post.data.tags.slice(0, 2).map((tag) => (
        <span class="text-[10px] px-2 py-0.5 rounded-sm bg-white/90 text-palm-900 font-sans font-semibold tracking-wide uppercase">
          {tag.replace(/-/g, ' ')}
        </span>
      ))}
    </div>
  </div>

  <div class="p-5">
    <p class="text-[11px] text-ink-light/50 font-sans tracking-wide">{formatDate(post.data.date)}</p>
    <h3 class="font-serif text-base font-bold text-palm-900 mt-2 group-hover:text-palm-700 transition-colors line-clamp-2">
      {post.data.title}
    </h3>
    <p class="text-sm text-ink-light/60 mt-2 line-clamp-2 leading-relaxed">
      {post.data.excerpt}
    </p>
  </div>
</a>
